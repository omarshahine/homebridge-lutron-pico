{
  "name": "homebridge-lutron-pico",
  "displayName": "Lutron Pico",
  "type": "module",
  "version": "1.0.0",
  "description": "Homebridge plugin that exposes only unassociated Lutron Pico remotes to HomeKit. Forked from homebridge-lutron-caseta-leap.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/omarshahine/homebridge-lutron-pico.git"
  },
  "bugs": {
    "url": "https://github.com/omarshahine/homebridge-lutron-pico/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "lutron",
    "caseta",
    "pico",
    "lutron-leap",
    "lutron-caseta"
  ],
  "main": "dist/index.js",
  "engines": {
    "homebridge": "^1.11.4 || ^2.0.0-beta.101",
    "node": "^22 || ^24"
  },
  "scripts": {
    "check": "npm install && npm outdated",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "watch": "npm run build && npm run plugin-ui && npm link && nodemon",
    "plugin-ui": "rsync ./src/homebridge-ui/public/index.html ./dist/homebridge-ui/public/",
    "build": "npm run clean && tsc && npm run plugin-ui",
    "prepublishOnly": "npm run lint && npm run build && npm run plugin-ui",
    "postpublish": "npm run clean && npm ci",
    "clean": "shx rm -rf ./dist",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.3",
    "lutron-leap": "^3.6.1",
    "node-forge": "^1.3.1",
    "typed-emitter": "^2.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "eslint": "^10.2.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-perfectionist": "^5.8.0",
    "homebridge": "^2.0.0-beta.101",
    "homebridge-config-ui-x": "^5.21.0",
    "nodemon": "^3.1.14",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
